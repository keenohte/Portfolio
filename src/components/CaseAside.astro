---
/**
 * Renders a Markdown blockquote inside a case study as an "agent" margin note.
 * Author it in .mdx like:
 *   > The insight that reframed the whole project.
 */
---

<aside class="case-aside">
  <span class="case-aside-tag" aria-hidden="true">
    <svg width="13" height="13" viewBox="0 0 22 22"><path d="M2 2 L2 16 L6.5 12.2 L9.2 18.5 L11.8 17.3 L9.1 11.2 L15 11 Z" fill="currentColor"/></svg>
    canvas agent
  </span>
  <div class="case-aside-body"><slot /></div>
</aside>

<style>
  .case-aside {
    border-left: 2px solid var(--accent);
    padding: 4px 0 4px 18px;
    margin: var(--space-l) 0;
    color: var(--text);
  }
  .case-aside-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 8px;
  }
  .case-aside-tag svg { display: inline-block; }
  .case-aside-body :global(p) {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.3rem);
    line-height: 1.35;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--text);
  }
</style>
