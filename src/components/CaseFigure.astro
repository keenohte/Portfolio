---
/**
 * A figure for case studies. Drop it into an .mdx body:
 *
 *   import Figure from "../../components/CaseFigure.astro";
 *   <Figure caption="What the screenshot shows." label="Phase 1" />
 *
 * With no `src` it renders a clean placeholder panel (aspect-ratio reserved,
 * so layout doesn't shift when the real image lands). Add a screenshot to
 * /public/work/ and pass its path to go live:
 *
 *   <Figure src="/work/zocdoc-phase-1.png" alt="…" caption="…" />
 *
 * Local paths (starting with "/") are made base-path aware automatically, so
 * "/work/foo.png" resolves correctly under the /portfolio base.
 */
import { link } from "../config";

interface Props {
  src?: string;
  alt?: string;
  caption?: string;
  label?: string; // short tag shown on the placeholder (e.g. "Before", "Phase 1")
  ratio?: string; // aspect-ratio, e.g. "16 / 10" (default) or "4 / 3"
  max?: string; // optional max-width, centered — use for portrait/phone shots (e.g. "340px")
}

const { src, alt, caption, label = "image", ratio = "16 / 10", max } = Astro.props;
const figStyle = max ? `max-width:${max};margin-inline:auto` : undefined;

// resolve root-relative asset paths against the site base; leave URLs untouched
const resolved =
  src && src.startsWith("/") && !src.startsWith("//") ? link(src) : src;
---

<figure class="case-fig" style={figStyle}>
  {
    resolved ? (
      <img src={resolved} alt={alt ?? caption ?? ""} loading="lazy" style={`aspect-ratio:${ratio}`} />
    ) : (
      <div class="fig-ph" style={`aspect-ratio:${ratio}`} aria-hidden="true">
        <span class="fig-ph-tag">{label}</span>
      </div>
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .case-fig {
    margin: var(--space-l) 0;
  }
  .case-fig img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    object-fit: cover;
  }
  /* placeholder panel — quiet tinted surface + faint dot texture, clearly a drop-zone */
  .fig-ph {
    position: relative;
    width: 100%;
    border-radius: var(--radius);
    border: 1px dashed color-mix(in srgb, var(--text) 20%, transparent);
    background:
      radial-gradient(color-mix(in srgb, var(--text) 8%, transparent) 1px, transparent 1px)
        0 0 / 18px 18px,
      linear-gradient(135deg, color-mix(in srgb, var(--accent) 8%, var(--surface-2)), var(--surface-2));
    display: grid;
    place-items: center;
  }
  .fig-ph-tag {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: lowercase;
    color: var(--text-muted);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    border: 1px solid var(--line);
    padding: 4px 10px;
    border-radius: 999px;
  }
  figcaption {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
    color: var(--text-muted);
    max-width: 60ch;
  }
</style>
