---
/**
 * A figure for case studies. Drop it into an .mdx body:
 *
 *   import Figure from "../../components/CaseFigure.astro";
 *   <Figure src="/work/foo.png" alt="…" caption="…" />
 *   <Figure video="/work/clip.mp4" poster="/work/foo.png" caption="…" />
 *
 * With no `src`/`video` it renders a placeholder panel (aspect-ratio reserved).
 * Real images render at their natural ratio (no crop). Local paths (starting
 * with "/") are made base-path aware, so "/work/foo.png" works under /portfolio.
 */
import { link } from "../config";

interface Props {
  src?: string;
  video?: string;
  poster?: string;
  alt?: string;
  caption?: string;
  label?: string; // short tag shown on the placeholder (e.g. "Before", "Phase 1")
  ratio?: string; // placeholder aspect-ratio, e.g. "16 / 10" (default)
  max?: string; // optional max-width, centered — use for portrait/phone shots
}

const { src, video, poster, alt, caption, label = "image", ratio = "16 / 10", max } =
  Astro.props;

const base = (p?: string) =>
  p && p.startsWith("/") && !p.startsWith("//") ? link(p) : p;
const imgSrc = base(src);
const vidSrc = base(video);
const posterSrc = base(poster);
const figStyle = max ? `max-width:${max};margin-inline:auto` : undefined;
---

<figure class="case-fig" style={figStyle}>
  {
    vidSrc ? (
      <video class="fig-media" controls preload="metadata" playsinline poster={posterSrc}>
        <source src={vidSrc} />
      </video>
    ) : imgSrc ? (
      <img class="fig-media" src={imgSrc} alt={alt ?? caption ?? ""} loading="lazy" />
    ) : (
      <div class="fig-ph" style={`aspect-ratio:${ratio}`} aria-hidden="true">
        <span class="fig-ph-tag">{label}</span>
      </div>
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .case-fig {
    margin: var(--space-l) 0;
  }
  /* real media renders at its natural ratio — screenshots show in full, no crop */
  .fig-media {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface-2);
  }
  /* placeholder panel — quiet tinted surface + faint dot texture, clearly a drop-zone */
  .fig-ph {
    position: relative;
    width: 100%;
    border-radius: var(--radius);
    border: 1px dashed color-mix(in srgb, var(--text) 20%, transparent);
    background:
      radial-gradient(color-mix(in srgb, var(--text) 8%, transparent) 1px, transparent 1px)
        0 0 / 18px 18px,
      linear-gradient(135deg, color-mix(in srgb, var(--accent) 8%, var(--surface-2)), var(--surface-2));
    display: grid;
    place-items: center;
  }
  .fig-ph-tag {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: lowercase;
    color: var(--text-muted);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    border: 1px solid var(--line);
    padding: 4px 10px;
    border-radius: 999px;
  }
  figcaption {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
    color: var(--text-muted);
    max-width: 60ch;
  }
</style>
